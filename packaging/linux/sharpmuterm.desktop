[Desktop Entry]
Type=Application
Name=SharpMUTerm
GenericName=MU* Client
Comment=A MUSH, MUCK and MUD client
Exec=sharpmuterm-window --open-link %U
Icon=sharpmuterm
Terminal=false
Categories=Game;RolePlaying;
Keywords=MUD;MUSH;MUCK;MU*;telnet;
StartupWMClass=sharpmuterm-window
# telnet:// and telnets:// links open the client. Registered only when the desktop integrates the AppImage
# (AppImageLauncher, appimaged, or `xdg-mime default sharpmuterm.desktop x-scheme-handler/telnet`); the program never
# registers itself.
MimeType=x-scheme-handler/telnet;x-scheme-handler/telnets;
# The other two ways to run it, offered on the launcher's right-click menu once the desktop integrates the AppImage
# (AppImageLauncher, appimaged, Gear Lever), which points every Exec at the AppImage and keeps the arguments. The plain
# entry above is the window with its own controls.
Actions=Emulated;Native;

[Desktop Action Emulated]
Name=SharpMUTerm (Emulated)
Exec=sharpmuterm-window --emulated

# AppRun opens a terminal for this when it was started without one (kitty or Ghostty first: they draw inline pictures).
[Desktop Action Native]
Name=SharpMUTerm (Native)
Exec=sharpmuterm-window --terminal
