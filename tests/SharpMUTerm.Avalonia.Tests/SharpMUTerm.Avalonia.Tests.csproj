    <Compile Include="..\SharpMUTerm.Tui.Tests\FrameGrid.cs" Link="Shared\FrameGrid.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpMUTerm.Avalonia\SharpMUTerm.Avalonia.csproj" />
  </ItemGroup>

</Project>
