<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SharpMUTerm.Avalonia.Tests</RootNamespace>
    <AssemblyName>SharpMUTerm.Avalonia.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>

  <!-- The terminal suite's frame decoder, so a headless frame and a window frame are read the same way. -->
  <ItemGroup>
    <Compile Include="..\SharpMUTerm.Tui.Tests\FrameGrid.cs" Link="Shared\FrameGrid.cs" />

    <!-- A transport that connects to nothing and keeps what was sent, so a composer's send is read off the wire. -->
    <Compile Include="..\SharpMUTerm.Tui.Tests\RecordingTelnetSession.cs" Link="Shared\RecordingTelnetSession.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpMUTerm.Avalonia\SharpMUTerm.Avalonia.csproj" />
  </ItemGroup>

</Project>
