<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SharpMUTerm.Tui</RootNamespace>
    <AssemblyName>sharpmuterm</AssemblyName>

    <!--
      Runtimes we ship single-file builds for. Declaring them here is build-safe (only used on
      `dotnet publish -r <rid>`); the single-file/self-contained knobs live in the publish
      profiles under Properties/PublishProfiles so they never affect `dotnet build`/`run`.
      See docs/PACKAGING.md.
    -->
    <RuntimeIdentifiers>linux-x64;linux-arm64;win-x64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!--
    SharpConsoleUI always comes from NuGet, at the version Directory.Packages.props pins. There is
    deliberately no source-reference path.

    There used to be one: a sibling clone at ../../SharpConsoleUI was detected by Exists() and
    preferred over the package unless UseSharpConsoleUIPackage=true was passed. It was opt-*out*, so
    merely having the clone on disk — which anyone reading the framework does — silently changed what
    this project compiled against, with nothing said at build time. That left a local build and CI
    compiling two different framework versions from one commit: local green stopped describing what
    ships, an agent working in a git worktree got the package (the relative path does not resolve
    from .claude/worktrees/) while the same code built from the main checkout got the clone, and an
    edit to the clone would have been invisible in this repository's diff.

    Read the framework by cloning it and opening it; do not wire it into this build.
  -->
  <ItemGroup>
    <PackageReference Include="SharpConsoleUI" />
  </ItemGroup>

  <!-- Decodes what the framework's StbImageSharp cannot: WebP, chiefly. See ImageDecoder. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <!-- The composition root for client diagnostics: Serilog is referenced here and nowhere else. -->
  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!--
    The app is shared by every host (terminal, desktop window, headless snapshot), so it may not decide
    anything by asking which driver it was handed or what the environment says: that is how a feature ends
    up working in one host and not the other. Those facts are ClientHost's (Hosting/), and the analyzer
    fails the build when they are reached for anywhere else. A use that has to stay carries a
    #pragma warning disable RS0030 with the reason beside it. It is an error by .editorconfig (this
    folder's), and off in Hosting/ by that folder's own.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="BannedSymbols.txt" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpMUTerm.Tui.Tests" />
    <!-- The windowed host: it runs the same SharpMUTermApp through Program.RunLive with its own driver. -->
    <InternalsVisibleTo Include="sharpmuterm-window" />
    <InternalsVisibleTo Include="SharpMUTerm.Avalonia.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpMUTerm.Core\SharpMUTerm.Core.csproj" />
    <ProjectReference Include="..\SharpMUTerm.Graphics\SharpMUTerm.Graphics.csproj" />
    <ProjectReference Include="..\SharpMUTerm.Scripting\SharpMUTerm.Scripting.csproj" />
    <ProjectReference Include="..\SharpMUTerm.Web\SharpMUTerm.Web.csproj" />
  </ItemGroup>

</Project>
