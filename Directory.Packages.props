<Project>

  <!-- Central package version management for the whole solution. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- TUI framework: compositor, split layouts, tabs, mouse, Kitty graphics (stable, net10). -->
    <PackageVersion Include="SharpConsoleUI" Version="2.7.8" />

    <!-- Telnet negotiation: TELOPT/NAWS/MTTS/EOR/CHARSET/MSSP/GMCP/MSDP/MCCP/MXP negotiation. -->
    <PackageVersion Include="TelnetNegotiationCore" Version="4.5.2" />

    <!-- The version, from the git tag (see Directory.Build.props). Build-time only. -->
    <PackageVersion Include="MinVer" Version="8.0.0" />

    <!-- Sandboxed Lua scripting (pure-managed, no native deps). -->
    <PackageVersion Include="MoonSharp" Version="2.0.0" />

    <!--
      Image decoding for what SharpConsoleUI's own decoder (StbImageSharp since 2.7) refuses — WebP
      above all. Six Labors Split License: Apache 2.0 for open-source use, which this is. Held at 3.1:
      4.x refuses to build without a Six Labors license key.

      The advisories NuGet reports against 3.1.12 are all in the TIFF codecs or in ICC/EXIF parsing.
      ImageDecoder registers the WebP module alone and skips metadata, so none is reachable from here;
      they are suppressed by id so that a *new* advisory still warns. Re-check before suppressing more.
    -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />

    <!-- Pure-managed HTML5 parser for the in-TUI web view. -->
    <PackageVersion Include="AngleSharp" Version="1.7.1" />

    <!-- Logging abstractions (TelnetNegotiationCore takes an ILogger). -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />

    <!--
      Client diagnostics: Serilog behind Microsoft.Extensions.Logging. Only the Tui's composition root
      (ClientDiagnostics) references Serilog types; everything else logs through ILogger. Sinks are a
      rolling file and an in-memory buffer — deliberately never a console sink, which would write to
      the screen this app owns and wreck the display.
    -->
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!--
      The windowed host (SharpMUTerm.Avalonia): a desktop window that draws the TUI's cell grid with Skia,
      for the platforms whose terminals cannot show a picture (Windows, behind ConPTY). SkiaSharp comes in
      through Avalonia.Skia, at the version Avalonia was built against.
    -->
    <PackageVersion Include="Avalonia" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Themes.Simple" Version="12.1.4" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.4" />

    <!-- PNG encoder for tests that need real image bytes; the sibling of the decoder SharpConsoleUI uses. -->
    <PackageVersion Include="StbImageWriteSharp" Version="1.16.7" />

    <!-- Keeps host decisions in Tui/Hosting: see src/SharpMUTerm.Tui/BannedSymbols.txt. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="3.3.4" />

    <!-- Test stack: TUnit (source-generated, runs on Microsoft.Testing.Platform). -->
    <PackageVersion Include="TUnit" Version="1.61.38" />
  </ItemGroup>

  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
  </ItemGroup>

</Project>
